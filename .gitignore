# Secrets. Never commit a real one.
.env
.env.local
*.key

# Build output. These get very large very fast: a single scroll build with
# ten video legs is 300MB+, and a working lab directory reached 12GB locally.
# Committing them once puts them in history permanently.
builds/
lab/
out/
dist/
*.mp4
*.mov
*.webm
# media/ holds the small looping WebP demos used by the README. They are the
# only committed media, and they are deliberately not video files.
!media/*.webp

# Node
node_modules/
package-lock.json
npm-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini
