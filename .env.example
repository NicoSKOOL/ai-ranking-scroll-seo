# Copy this file to .env and fill in your own keys. Never commit .env.
# Both are optional: a build from your own photos needs no key at all.

# fal.ai key: image generation through GPT Image 2.5 (default route, supports
# transparent layers for the hero). Get one at https://fal.ai
FAL_KEY=your-fal-key-here

# kie.ai key: alternative route, also generates scroll-scrubbed video clips.
# Get one at https://kie.ai
KIE_AI_API_KEY=your-kie-key-here
